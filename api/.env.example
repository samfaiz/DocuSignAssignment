APP_NAME=SignDesk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Where the React SPA is served from. Used to build the signing links that go
# out by email, so it must be the address a signer can actually reach.
SPA_URL=http://localhost:5173

APP_LOCALE=en
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Postgres, not MySQL: the schema uses jsonb with GIN indexing for audit
# payloads, CHECK constraints for the envelope state machine, and a plpgsql
# trigger that makes the audit table append-only.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=signdesk
DB_USERNAME=signdesk
DB_PASSWORD=signdesk

SESSION_DRIVER=database
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log

# Sealing makes a network round trip to a timestamp authority, so it runs on a
# queue and retries rather than blocking a request.
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# predis rather than phpredis: pure PHP, no extension to build.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=63790
REDIS_PASSWORD=null

# MinIO locally, real S3 in production. Documents never live in the database and
# are never served from a guessable path.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=signdesk
AWS_SECRET_ACCESS_KEY=signdesk123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=signdesk
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Mailpit catches everything locally: http://localhost:8025
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@signdesk.test"
MAIL_FROM_NAME="${APP_NAME}"

# The PAdES sealing service. Must have no public ingress: it seals documents
# with your certificate and is protected only by the shared secret below.
SIGN_SERVICE_URL=http://127.0.0.1:8001
SIGN_SERVICE_SECRET=change-me-to-a-long-random-string
SIGN_SERVICE_TIMEOUT=180
SIGN_PADES_LEVEL=b-lta

# Signing links and one-time passcodes.
SIGN_TOKEN_TTL_DAYS=30
SIGN_OTP_TTL_MINUTES=10
SIGN_OTP_MAX_ATTEMPTS=5
SIGN_OTP_LOCKOUT_MINUTES=15

# Version of the electronic-records disclosure shown on the consent screen.
# Past consents keep pointing at the text that was actually on screen.
ESIGN_DISCLOSURE_VERSION=esign-disclosure-v1

# Reviewer conveniences: provisions a demo envelope and reveals the one-time
# passcode over the API. MUST be false anywhere reachable from the internet —
# with it on, anyone who can reach the API can finish someone else's signature.
# Defaults to on only when APP_ENV=local.
DEMO_MODE=true
